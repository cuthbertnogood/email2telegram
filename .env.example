# Yandex Mail IMAP — https://yandex.ru/support/mail/mail-clients/mail-clients-others.html
# Use your full address: @yandex.ru, @yandex.com, @ya.ru, or a domain on Yandex 360.
# Password: from Yandex ID → Безопасность → Пароли приложений (not your normal login if 2FA is on).
IMAP_HOST=imap.yandex.com
IMAP_PORT=993
IMAP_USER=you@yandex.ru
IMAP_PASS=your_yandex_app_password
IMAP_MAILBOX=INBOX
POLL_INTERVAL_SECONDS=45
# Heartbeat: optional Telegram ping on a schedule (counter in state file).
# HEARTBEAT_INTERVAL_SECONDS: grid step in seconds. HEARTBEAT_MINUTE (0-59): anchor minute within the hour.
# Defaults 900 + 45 -> ticks at :00, :15, :30, :45 (process timezone; set TZ in Docker if needed). After restart, first tick is the next grid point.
HEARTBEAT_INTERVAL_SECONDS=900
HEARTBEAT_MINUTE=45
# Set HEARTBEAT_INTERVAL_SECONDS=0 to disable.

# Optional on VPS (Docker): timezone for log timestamps, e.g. Europe/Moscow
# TZ=UTC

# Docker Hub (PC): login (hub.docker.com). ./scripts/host_to_docker_hub.sh loads .env; shell-exported DOCKER_USER wins over .env.
# Optional: TAG=latest (default), NO_BUMP=1 to skip MINOR bump before build.
# On the VPS, DOCKER_IMAGE must use the same name before /email2telegram.
DOCKER_USER=YOUR_DOCKERHUB_USER

# Docker Hub deploy (with docker-compose.hub.yml on the VPS):
# DOCKER_IMAGE=YOUR_DOCKERHUB_USER/email2telegram:latest

# VPS — for ./scripts/host_to_vps.sh from your PC (sync / pull-up / deploy). See docs/dev/deploy-to-vps.md.
# VPS_USER=deploy
# VPS_HOST=203.0.113.10
# VPS_SSH_PORT=22
# VPS_REMOTE_DIR=/opt/email2telegram
# Optional: extra ssh/scp args, e.g. -i ~/.ssh/id_ed25519
# VPS_SSH_OPTS=
# Optional: set to 1 for ssh -v when pull-up/deploy fails with "Connection closed"
# VPS_SSH_VERBOSE=1
# Optional: max SSH attempts for pull-up/deploy (default 3; backoff between tries on transient drops)
# VPS_PULL_UP_RETRIES=3
# Optional: seconds to sleep after VPS sync before pull-up in ./scripts/release.sh only (SSH rate limits)
# VPS_POST_SYNC_SLEEP=15

TELEGRAM_BOT_TOKEN=123456:ABCDEF_your_bot_token
# Comma-separated chat IDs that may receive mail and use /start (your user id in private chat).
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Must be one of the IDs above (usually the same as your user id in private chat).
TELEGRAM_CHAT_ID=123456789

# Optional: also save each delivered message as mail_export/{uid}.eml (same run as Telegram).
# EXPORT_MAIL_DIR=mail_export
# Optional: state file path (default .state.json). In Docker: /data/.state.json
# STATE_FILE=.state.json

# Optional: README.ru.md auto-translation (used by scripts/sync_readme_ru.py --translate)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
