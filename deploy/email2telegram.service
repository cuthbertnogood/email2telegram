# Example systemd unit: start stack at boot (adjust WorkingDirectory).
#   sudo cp deploy/email2telegram.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now email2telegram.service
#
# Requires: Docker Engine with Compose plugin.

[Unit]
Description=email2telegram (Docker Compose)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/email2telegram
# Use docker-compose.hub.yml if the image is pulled from Docker Hub:
ExecStart=/bin/sh -c '/usr/bin/docker compose -f docker-compose.hub.yml pull && /usr/bin/docker compose -f docker-compose.hub.yml up -d'
ExecStop=/bin/sh -c '/usr/bin/docker compose -f docker-compose.hub.yml down'
# For build on server instead, swap for: docker compose up -d --build
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
